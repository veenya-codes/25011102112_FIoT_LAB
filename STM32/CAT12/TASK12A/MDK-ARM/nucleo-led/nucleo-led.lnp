--cpu=Cortex-M4.fp.sp
"nucleo-led\startup_stm32f401xe.o"
"nucleo-led\main.o"
"nucleo-led\stm32f4xx_it.o"
"nucleo-led\stm32f4xx_hal_msp.o"
"nucleo-led\stm32f4xx_hal_rcc.o"
"nucleo-led\stm32f4xx_hal_rcc_ex.o"
"nucleo-led\stm32f4xx_hal_flash.o"
"nucleo-led\stm32f4xx_hal_flash_ex.o"
"nucleo-led\stm32f4xx_hal_flash_ramfunc.o"
"nucleo-led\stm32f4xx_hal_gpio.o"
"nucleo-led\stm32f4xx_hal_dma_ex.o"
"nucleo-led\stm32f4xx_hal_dma.o"
"nucleo-led\stm32f4xx_hal_pwr.o"
"nucleo-led\stm32f4xx_hal_pwr_ex.o"
