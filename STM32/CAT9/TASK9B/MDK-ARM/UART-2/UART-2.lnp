--cpu Cortex-M3
"uart-2\startup_stm32f103xb.o"
"uart-2\main.o"
"uart-2\stm32f1xx_it.o"
"uart-2\stm32f1xx_hal_msp.o"
"uart-2\stm32f1xx_hal_gpio_ex.o"
"uart-2\stm32f1xx_hal_uart.o"
"uart-2\stm32f1xx_hal.o"
"uart-2\stm32f1xx_hal_rcc.o"
"uart-2\stm32f1xx_hal_rcc_ex.o"
"uart-2\stm32f1xx_hal_gpio.o"
"uart-2\stm32f1xx_hal_dma.o"
"uart-2\stm32f1xx_hal_cortex.o"
"uart-2\stm32f1xx_hal_pwr.o"
"uart-2\stm32f1xx_hal_flash.o"
"uart-2\stm32f1xx_hal_flash_ex.o"
"uart-2\stm32f1xx_hal_exti.o"
"uart-2\system_stm32f1xx.o"
--strict --scatter "UART-2\UART-2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "UART-2.map" -o UART-2\UART-2.axf